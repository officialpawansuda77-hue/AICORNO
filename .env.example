# ====================================================================
# AICORN PRODUCTION ENVIRONMENT TEMPLATE (.env.example)
# Clerk (Auth) + Supabase (PostgreSQL Database, RLS, Storage)
# ====================================================================

# Vercel AI Gateway (server-side only; never prefix with NEXT_PUBLIC_)
AI_GATEWAY_API_KEY=your-rotated-ai-gateway-key

# Clerk Authentication
# Use production Clerk keys for deployed environments (pk_live_ / sk_live_).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_SECRET_KEY=sk_live_...

# Supabase (PostgreSQL Database, RLS & Storage for Images/Videos)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Dodo Payments — server-only secrets, NEVER prefix these two with NEXT_PUBLIC_.
# Rotate any keys previously shared in chat, then configure the new values in Vercel.
DODO_PAYMENTS_API_KEY=your-rotated-api-key
DODO_PAYMENTS_WEBHOOK_KEY=your-rotated-webhook-signing-key
# Set live_mode only for a live API key and live products (default is test_mode).
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_STARTER_PRODUCT_ID=your-starter-subscription-product-id
DODO_PRO_PRODUCT_ID=your-pro-subscription-product-id
# Alternatively use NEXT_PUBLIC_DODO_STARTER_PRODUCT_ID / NEXT_PUBLIC_DODO_PRO_PRODUCT_ID
# for product IDs only (these IDs are public; API and webhook keys must remain private).
