# ====================================================================
# AICORN PRODUCTION ENVIRONMENT TEMPLATE (.env.example)
# Clerk (Auth) + Supabase (PostgreSQL Database, RLS, Storage)
# ====================================================================

# Clerk Authentication
# Use production Clerk keys for deployed environments (pk_live_ / sk_live_).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_SECRET_KEY=sk_live_...

# Supabase (PostgreSQL Database, RLS & Storage for Images/Videos)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
